# ==============================================================================
# E-commerce Marketplace - Environment Configuration (.env)
# ==============================================================================
# Create a copy of this file named '.env' and add your Firebase and Payment Gateway credentials.
# ==============================================================================

# Firebase Web App Credentials
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# Authorized Admin Firebase UID
VITE_ADMIN_UID=""

# Payment Gateway Credentials (PayBD / Pipilik Host or similar)
PAYBD_API_KEY=""
PAYBD_SECRET_KEY=""
PAYBD_BRAND_KEY=""
PAYBD_GATEWAY_URL="https://app-paybd.pipilikhost.com/api/payment/create"

# Optional: Gemini API Key (if AI features are used)
GEMINI_API_KEY=""
